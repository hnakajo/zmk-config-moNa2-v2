#include "mona2.dtsi"

/* mona2.dtsi 内で RC(row,col) のマトリクス展開が終わった後に include する */
#include <input/processors/runtime-input-processor.dtsi>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

&default_transform {
    col-offset = <6>;
};

&kscan0 {
    col-gpios
        = <&xiao_d 10 GPIO_ACTIVE_HIGH>
        , <&xiao_d 9 GPIO_ACTIVE_HIGH>
        , <&xiao_d 8 GPIO_ACTIVE_HIGH>
        , <&xiao_d 7 GPIO_ACTIVE_HIGH>
        , <&gpio0 10 GPIO_ACTIVE_HIGH>
        ;
};

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                    <NRF_PSEL(SPIM_MISO, 0, 4)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                    <NRF_PSEL(SPIM_MISO, 0, 4)>;
            low-power-enable;
        };
    };
};

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;

    trackball_central: trackball_central@0 {
        status = "okay";

#ifdef CONFIG_TRACKBALL_PAW3222
        compatible = "pixart,paw3222";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

#else
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        cpi = <600>;
        invert-x;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
#endif
    };
};


/* ============================================================
 * SCROLL
 *
 * layer 6 = scroll_win
 * layer 7 = scroll_mac
 * ============================================================ */

&scroll_runtime_input_processor {
    x-codes = <INPUT_REL_X>;
    y-codes = <INPUT_REL_Y>;

    xy-to-scroll-enabled;

    active-layers = <0x000000C0>;

    scale-multiplier = <1>;
    scale-divisor = <4>;
};


/* ============================================================
 * MOUSE
 * ============================================================ */

&mouse_runtime_input_processor {
};


/* ============================================================
 * TRACKBALL LISTENER
 *
 * Windows:
 *   通常 layer 0
 *   Auto Mouse → layer 4
 *
 * Mac:
 *   layer 1 が有効
 *   Auto Mouse → layer 5
 *
 * Scroll:
 *   layer 6 / 7 の間は mouse ではなく scroll
 *
 * timeout:
 *   roBa と同じ 700ms
 * ============================================================ */

&trackball_central_listener {
    status = "okay";
    device = <&trackball_central>;


    /* --------------------------------------------------------
     * Scroll
     *
     * layer 6/7 が有効なら、これが最優先。
     * Auto Mouse は発動させない。
     * -------------------------------------------------------- */

    scroll_mode {
        layers = <6 7>;

        input-processors =
            <&scroll_runtime_input_processor>;
    };


    /* --------------------------------------------------------
     * Mac Auto Mouse
     *
     * layer 1 が有効ならこちらを使う。
     * トラックボールを動かすと layer 5 (MOUSE_M) を有効化。
     * -------------------------------------------------------- */

    mac_automouse {
        layers = <1>;

        input-processors =
            <&zip_temp_layer 5 700>,
            <&mouse_runtime_input_processor>;
    };


    /* --------------------------------------------------------
     * Windows Auto Mouse
     *
     * layer 1 が有効でない場合はこちら。
     * トラックボールを動かすと layer 4 (MOUSE_W) を有効化。
     * -------------------------------------------------------- */

    input-processors =
        <&zip_temp_layer 4 700>,
        <&mouse_runtime_input_processor>;
};
